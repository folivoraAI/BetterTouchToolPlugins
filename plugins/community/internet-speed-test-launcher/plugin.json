{
  "name": "Internet Speed Test",
  "identifier": "com.btt.ai.speedtest.launcher",
  "type": "Launcher",
  "version": "1.0.0",
  "icon": "speedometer",
  "shortDescription": "A Raycast-inspired Internet speed test dashboard for BetterTouchTool Launcher.",
  "description": "Runs macOS networkQuality and displays download/upload gauges, live throughput animation, peak graphs, latency, responsiveness, endpoint and transfer details inside BTT Launcher.",
  "author": "loaykhalifa",
  "license": "MIT",
  "minMacOSVersion": "12.0",
  "repository": "https://github.com/loaykhalifa/BetterTouchToolPlugins",
  "homepage": "https://github.com/loaykhalifa/BetterTouchToolPlugins/tree/master/plugins/community/internet-speed-test-launcher",
  "screenshot": "https://github.com/loaykhalifa/BetterTouchToolPlugins/blob/master/plugins/community/internet-speed-test-launcher/Screenshot.jpg",
  "screenshots": [
    "https://github.com/loaykhalifa/BetterTouchToolPlugins/blob/master/plugins/community/internet-speed-test-launcher/Screenshot.jpg"
  ],
  "requirements": [
    "BetterTouchTool with Swift plugin support",
    "macOS /usr/bin/networkQuality command",
    "Apple Command Line Tools if BTT asks to compile Swift plugins"
  ],
  "keywords": [
    "launcher",
    "speedtest",
    "networkQuality",
    "internet",
    "download",
    "upload",
    "latency",
    "throughput"
  ],
  "files": [
    {
      "path": "SpeedTestLauncherPlugin.swift",
      "type": "swift-source-plugin"
    },
    {
      "path": "Screenshot.jpg",
      "type": "screenshot"
    }
  ],
  "installation": [
    "Copy SpeedTestLauncherPlugin.swift to ~/Library/Application Support/BetterTouchTool/Plugins/",
    "Restart BetterTouchTool or wait for plugin reload.",
    "Open BTT Launcher and search for Test Internet Speed."
  ]
}